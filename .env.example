# Copy to .env, then add your key locally. Never commit .env.
GEMINI_API_KEY=
MODEL_FAST=gemini-3.1-flash-lite,gemini-flash-lite-latest
MODEL_SMART=gemini-3.5-flash,gemini-3-flash-preview
RPM_LIMIT=5
TPM_LIMIT=250000
RPD_LIMIT=20
SAFETY=0.8
MAX_CALLS_PER_RUN=15
MAX_ORGS=8
MAX_PAGES_PER_ORG=3
BATCH_ORGS=3
MAX_SNIPPET_FALLBACKS=5
REPLAN_ROUNDS=1
OFFLINE=1
