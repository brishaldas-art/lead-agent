# Copy to .env, then add your key locally. Never commit .env.
GEMINI_API_KEY=
MODEL_FAST=gemini-3.1-flash-lite,gemini-flash-lite-latest
MODEL_SMART=gemini-3.5-flash,gemini-3-flash-preview
RPM_LIMIT=5
TPM_LIMIT=250000
RPD_LIMIT=20
SAFETY=0.8
# Safe multi-run profile: cap each full run and keep discovery focused.
MAX_CALLS_PER_RUN=10
MAX_ORGS=20
MAX_PAGES_PER_ORG=3
BATCH_ORGS=5
MAX_SNIPPET_FALLBACKS=2
MIN_ORGS=5
REPLAN_ROUNDS=1
MAX_CANDIDATES=40
MAX_SEED_ORGS=10
MAX_ENRICHMENT_SEEDS=4
TIME_BUDGET_MIN=8
SEARCH_CACHE_TTL_HOURS=48
PAGE_CACHE_TTL_HOURS=72
OFFLINE=1

# Optional Step 5 Google Sheets export. Leave blank for local CSV/SQLite only.
SHEET_ID=
GOOGLE_CREDENTIALS=credentials.json
