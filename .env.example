@'
GEMINI_API_KEY=
MODEL_FAST=gemini-3.1-flash-lite,gemini-flash-lite-latest
MODEL_SMART=gemini-3.5-flash,gemini-3-flash-preview
RPM_LIMIT=5
TPM_LIMIT=250000
RPD_LIMIT=20
SAFETY=0.8
MAX_CALLS_PER_RUN=15
OFFLINE=0
'@ | Set-Content -Encoding ascii .env.example

git add .env.example
git commit -m "add .env.example"